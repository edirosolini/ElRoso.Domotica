[Unit]
Description=Domotica - bot de Telegram que habla por el parlante
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=/etc/domotica/domotica.env
Environment=PYTHONPATH=/opt/domotica/src
Environment=OMP_NUM_THREADS=1
ExecStart=/opt/domotica/venv/bin/python -m homeauto.main
Restart=always
RestartSec=5
StateDirectory=domotica

[Install]
WantedBy=multi-user.target
